# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required.
DISCORD_TOKEN=your-token-here

# Cog modules to load at startup, separated by commas. The default is help only.
COGS_TO_LOAD=help,template,voice,admin,moderation,events

# Optional settings follow. The values shown are the defaults.

# Replies follow each user's Discord language. LOCALE is the fallback for other languages.
# Built-in values are en and fi. Silent mutes public replies but still sends private ones, such as /help and admin replies.
# LOCALE=silent

# SQLite file for per-guild settings and moderation data. The directory is created if needed.
# The Docker image sets this to /app/data/bot.db, which compose keeps on a volume.
# DATABASE_PATH=data/bot.db

# FFmpeg executable. Leave it unset to use FFmpeg from the system PATH.
# FFMPEG_PATH=ffmpeg

# A server ID for development. Commands sync to that server instantly instead of globally.
# Leave it unset in production.
# DEV_GUILD_ID=

# Each discord-api-* service is configured with a URL and a secret named after the service.
# The secret must match DISCORD_API_SECRET in that service's own configuration.
# The media cog needs discord-api-media. compose.stack.yml overrides the URL inside the stack.
# DISCORD_API_MEDIA_URL=http://localhost:8001
# DISCORD_API_MEDIA_SECRET=your-secret-here
