# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required.
DISCORD_TOKEN=your-token-here

# Cog modules to load at startup, separated by commas. The default is help only.
COGS_TO_LOAD=help,template,voice,admin,moderation,events

# Optional settings follow. The values shown are the defaults.

# Replies follow each user's Discord language. LOCALE is the fallback for other languages.
# Built-in values are en and fi. Silent mutes public replies but still sends private ones, such as /help and admin replies.
# LOCALE=silent

# SQLite file for per-guild settings and moderation data. The directory is created if needed.
# The Docker image sets this to /app/data/bot.db, which compose keeps on a volume.
# DATABASE_PATH=data/bot.db

# FFmpeg executable. Leave it unset to use FFmpeg from the system PATH.
# FFMPEG_PATH=ffmpeg

# A server ID for development. Commands sync to that server instantly instead of globally.
# Leave it unset in production.
# DEV_GUILD_ID=

# A heartbeat service, such as healthchecks.io, alerts you when the bot stops reporting that it is online.
# Paste the check's ping URL here. It works like a password, so keep it private.
# This setting has no default value, so the URL below is only an example. The README shows how to get one.
# HEARTBEAT_URL=https://hc-ping.com/your-check-id

# A Discord webhook that hears when a nightly update installs a new release or fails.
# Create one in a channel's settings under Integrations, then Webhooks, and paste its URL here.
# It works like a password, so keep it private. The README shows the steps.
# UPDATE_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook

# Each api-* service is configured with a URL and a secret named after the service.
# The secret must match API_SECRET in that service's own configuration.
# The media cog needs api-media. compose.stack.yml overrides the URL inside the stack.
# API_MEDIA_URL=http://localhost:8001
# API_MEDIA_SECRET=your-secret-here
# How many songs may wait in a server's music queue. 500 by default.
# MAX_QUEUE_LENGTH=500
