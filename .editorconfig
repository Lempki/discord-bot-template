# >>> dev-standards managed block. Change it in dev-standards.
# Shared editor settings from dev-standards. Add this repository's own sections below the block.
# EditorConfig covers whitespace and encoding only. The linters and the check-prose hook cover the rest.

root = true

[*]
# UTF-8 without a BOM and LF endings, so a file reads the same on Windows, in Linux containers, and in Git.
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.{bat,cmd}]
# The Windows command interpreter misreads some scripts saved with LF endings.
end_of_line = crlf
# <<< dev-standards managed block.
